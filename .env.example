# 공개할 웹 포트
WEB_PORT=8080

# 요청 한 번에 모델에 보내는 Expert 작업 수와 JSON 출력 토큰 예산
# 전체 작업은 이 크기에 맞춰 여러 요청으로 나뉘며 버려지지 않습니다.
WEB_DETECTION_MAX_EXPERT_TASKS=6
WEB_DETECTION_MAX_OUTPUT_TOKENS=16384

# 실제 도메인을 지정하는 경우 예: security.example.com
ALLOWED_HOSTS=*

# OpenRouter API Key와 모델은 이 파일에 저장하지 않습니다.
# 로그인한 사용자가 분석/패치 화면에서 직접 입력합니다.
