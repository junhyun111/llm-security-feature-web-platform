# 공개할 웹 포트
WEB_PORT=8080

# Candidate × Expert 독립 요청의 최대 동시 실행 수(코드 상한 100)
WEB_MAX_CONCURRENT_EXPERT_REQUESTS=100
WEB_DETECTION_MAX_OUTPUT_TOKENS=16384

# 최초 요청 + 일시적 오류 시 재시도 1회
REQUEST_TIMEOUT_SECONDS=90
MAX_RETRIES=1
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_PROVIDER_SORT=throughput
OPENROUTER_PROVIDER_IGNORE=baidu

# 실제 도메인을 지정하는 경우 예: security.example.com
ALLOWED_HOSTS=*

# OpenRouter API Key와 모델은 이 파일에 저장하지 않습니다.
# 로그인한 사용자가 Settings 화면에서 직접 입력합니다.
